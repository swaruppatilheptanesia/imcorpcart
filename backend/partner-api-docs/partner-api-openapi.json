            "type": "string",
            "nullable": true
          },
          "tentativeDeliveryDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Null once delivered or closed"
          },
          "dispatchedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
