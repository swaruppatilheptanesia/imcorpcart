// ─────────────────────────────────────────────────────────────────────────────
// Catalog management (spec §2 — P1, Super Admin)
// Products, categories/sub-categories, dual EPP / Smart EPP pricing, visibility.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  coupons  Coupon[]

  exhibitionCampaigns ExhibitionCampaign[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  sku         String        @unique
  name        String
  brand       String?
  description String?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  subCategory String?       @map("sub_category") // e.g. flagship / audio / backpacks
  status      ProductStatus @default(DRAFT)

  // Whether this product comes under Smart EPP (SEPP). Authoring flag set by the
  // Super Admin (product form / bulk import); Smart-EPP checkout itself is not
  // yet wired, so this is currently a data attribute.
  smartEpp Boolean @default(false) @map("smart_epp")

  // Product-level list price (MRP) + public/pre-login MOP, authored by the Super
  // Admin (single published prices). Per-reseller EPP/Smart-EPP selling prices +
  // stock live on ProductOffer. MOP null falls back to MRP for the public catalog.
  mrp Decimal? @db.Decimal(12, 2)
  mop Decimal? @db.Decimal(12, 2)

  // Cashback the shopper earns on purchase (credited to their wallet on delivery).
  // PERCENT → cashbackValue is a % of the paid item price; FIXED → ₹ per unit.
  cashbackType  CashbackType @default(NONE) @map("cashback_type")
  cashbackValue Decimal?     @map("cashback_value") @db.Decimal(12, 2)

  // Tax + policy attributes (Super-Admin set on the master; shown on the product
  // page and used for partner catalog feeds / tax-correct invoices).
  hsnCode      String?  @map("hsn_code") // HSN/SAC code
  gstPercent   Decimal? @map("gst_percent") @db.Decimal(5, 2) // GST rate %
  termsText    String?  @map("terms_text") // Terms & Conditions
  warrantyText String?  @map("warranty_text") // Warranty T&C

  // Legacy single-seller FK. DEPRECATED by the marketplace ProductOffer model
  // (a product can have many resellers). Kept nullable for back-compat; new
  // products leave it null and derive sellers from `offers`.
  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id])

  // Optional free-text options (comma-separated), primarily for mobiles.
  colorOptions   String? @map("color_options") // e.g. "Black, Blue, White"
  variantOptions String? @map("variant_options") // e.g. "128GB, 256GB, 512GB"

  // Amazon-style variant family: separate SKUs sharing a `familyKey` are sibling
  // variations. Each carries its own colour + config axis value. Null familyKey =
  // a standalone product. The storefront collapses a family to one card and the
  // detail page renders colour/variant selectors that switch between siblings.
  familyKey     String? @map("family_key")
  optionColor   String? @map("option_color") // this SKU's colour label, e.g. "Gold"
  optionVariant String? @map("option_variant") // this SKU's config label, e.g. "64GB"

  // Storefront presentation fields (drive the shopper catalog cards / detail).
  rating      Float?  @map("rating") // average customer rating, 0–5
  reviewCount Int?    @map("review_count")
  freebieText String? @map("freebie_text") // first-party freebie text (reseller products use freeGift)
  specs       Json?   @map("specs") // [{k,v}] key-value spec rows

  // Attached reseller-managed free gift (null = none). Reseller products use this
  // instead of freebieText; the storefront badge shows the gift's title.
  freeGiftId String?
  freeGift   FreeGift? @relation(fields: [freeGiftId], references: [id])

  // Inbound-import provenance. Set when a product was imported from an external
  // VendorSource (null for internally-authored / bulk-imported products).
  // externalRef = the vendor's own SKU/id (namespaced into `sku` for dedup).
  sourceId    String?
  source      VendorSource? @relation(fields: [sourceId], references: [id])
  externalRef String?       @map("external_ref")

  // Admin per-product show/hide on the storefront (independent of `status`; a
  // re-sync never touches it). Combined with VendorSource.active (vendor suspend).
  hidden Boolean @default(false)

  images       ProductImage[]
  prices       ProductPrice[] // DEPRECATED — superseded by ProductOffer
  offers       ProductOffer[]
  visibilities ProductVisibility[]
  inventory    Inventory? // DEPRECATED — per-offer stock lives on ProductOffer

  cartItems      CartItem[]
  smartEppItems  SmartEppRequestItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  reviews        ProductReview[]
  partnerEntries PartnerCatalogueEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([subCategory])
  @@index([resellerId])
  @@index([status])
  @@index([familyKey])
  @@index([sourceId])
  @@map("products")
}

// Employee's saved products (backs storefront wishlist + "most wishlisted" analytics).
model WishlistItem {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([employeeId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// Employee-submitted product review. Starts PENDING and is only shown on the
// storefront (and folded into Product.rating/reviewCount) once a Super Admin
// APPROVES it. One review per (employee × product); editing resets to PENDING.
model ProductReview {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int // 1–5
  title      String?
  body       String
  status     ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, productId])
  @@index([productId, status])
  @@map("product_reviews")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Dual pricing: one row per PriceType (EPP / Smart EPP), with effective window.
model ProductPrice {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceType     PriceType
  mrp           Decimal   @db.Decimal(12, 2)
  // Market Operating Price — the public/pre-login price (Samsung B2B model).
  // Null falls back to MRP for the public catalog projection.
  mop           Decimal?  @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, priceType, isActive])
  @@map("product_prices")
}

// Marketplace offer/listing: one row per (product × reseller). A product can be
// sold by many resellers, each with their own selling prices + stock. The
// storefront "buy box" picks the cheapest active, in-stock offer. A null
// resellerId is the first-party / house offer.
model ProductOffer {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id])

  eppPrice      Decimal  @db.Decimal(12, 2) // customer EPP price (what the shopper pays; drives the buy box)
  // Reseller's own selling price (what the reseller receives). Platform
  // commission = eppPrice − resellerPrice. Null until the reseller sets it.
  resellerPrice Decimal? @map("reseller_price") @db.Decimal(12, 2)
  smartEppPrice Decimal? @db.Decimal(12, 2) // Smart-EPP selling price (optional)
  mop           Decimal? @db.Decimal(12, 2) // DEPRECATED — public MOP is now Product.mop (admin-set)
  quantity      Int      @default(0)

  // One of the offer reseller's own free gifts (null = none).
  freeGiftId String?
  freeGift   FreeGift? @relation(fields: [freeGiftId], references: [id])

  // DRAFT until the reseller sets a price; only ACTIVE + isActive + in-stock
  // offers are eligible for the buy box.
  status   ProductStatus @default(DRAFT)
  isActive Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, resellerId])
  @@index([productId])
  @@index([resellerId])
  @@map("product_offers")
}

// Visibility control (spec §2): global, or scoped to a specific company.
model ProductVisibility {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  scope     VisibilityScope @default(GLOBAL)
  companyId String? // set when scope = COMPANY
  isVisible Boolean         @default(true)

  createdAt DateTime @default(now())

  @@unique([productId, scope, companyId])
  @@index([companyId])
  @@map("product_visibilities")
}

model Inventory {
  id        String          @id @default(cuid())
  productId String          @unique
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int             @default(0)
  status    InventoryStatus @default(IN_STOCK)

  updatedAt DateTime @updatedAt

  @@map("inventory")
}

// Courier delivery TAT (turnaround time) per destination pincode, used for the
// storefront delivery-estimate + serviceability. Seeded from the courier TAT
// sheet (currently Blue Dart only) and editable via the Super-Admin "Manage
// Pincodes" screen: one row per (pincode × courier × mode). The delivery engine
// picks the fastest row that is Active + serviceable + not globally disabled.
model PincodeTat {
  id          String       @id @default(cuid())
  pincode     String
  courier     CourierCode  @default(BLUEDART)
  mode        DeliveryMode
  tatDays     Int          @map("tat_days") // serviceable TAT (days) for this mode; 0 when not serviceable
  serviceable Boolean      @default(true) // "Is deliverable" for this mode
  edl         Boolean      @default(false) // reachable only via EDL/ODA (extended delivery area)
  isActive    Boolean      @default(true) @map("is_active") // Status (Active/Inactive)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([pincode, courier, mode])
  @@index([pincode])
  @@index([courier])
  @@index([mode])
  @@map("pincode_tat")
}

// Global courier/mode kill-switches for the delivery engine. A row keyed
// `courier:BLUEDART` or `mode:SURFACE` with enabled=false excludes every matching
// pincode row platform-wide. Absence of a row = enabled.
model DeliverySetting {
  id        String   @id @default(cuid())
  key       String   @unique // "courier:BLUEDART" | "mode:SURFACE" | ...
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("delivery_settings")
}
