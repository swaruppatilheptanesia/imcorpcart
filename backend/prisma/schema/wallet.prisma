// ─────────────────────────────────────────────────────────────────────────────
// imcorpcart Wallet — spendable cashback earned on delivered orders.
// One wallet per employee; the append-only ledger is the source of truth and the
// cached `balance` is kept for fast reads (mirrors the CreditLedger pattern).
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Cached spendable balance — derived from the ledger, kept for fast reads.
  balance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries WalletLedgerEntry[]

  @@map("wallets")
}

model WalletLedgerEntry {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type         WalletLedgerType
  amount       Decimal          @db.Decimal(12, 2) // always positive; `type` gives direction
  balanceAfter Decimal          @db.Decimal(12, 2)

  // Polymorphic pointer to what moved the money (e.g. "ORDER" + order id).
  referenceType String?
  referenceId   String?
  note          String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("wallet_ledger_entries")
}
