// ─────────────────────────────────────────────────────────────────────────────
// Organizations & tenancy (spec §2 — P1)
// Company (corporate customer) + partner orgs (Leasing / Reseller / Fulfillment).
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id     String    @id @default(cuid())
  name   String
  gstin  String?   @unique
  status OrgStatus @default(ONBOARDING)

  // Smart EPP (SEPP) is available to this company's employees only when the
  // Super Admin enables it here. Gates the storefront's EMI/Smart-EPP option.
  smartEppEnabled Boolean @default(false) @map("smart_epp_enabled")

  // Smart EPP lease partner + per-company lease inputs (Super-Admin-set).
  // The leasing company supplies PTPM / PV discount / advance fee; the company
  // supplies the ADLD insurance rate (annual % of asset cost, null = none) and
  // the income-tax slab used for the employee's tax-shelter illustration.
  leasingCompanyId String?         @map("leasing_company_id")
  leasingCompany   LeasingCompany? @relation(fields: [leasingCompanyId], references: [id])
  adldPct          Decimal?        @map("adld_pct") @db.Decimal(5, 2)
  incomeTaxPct     Decimal         @default(30) @map("income_tax_pct") @db.Decimal(5, 2)

  // Corporate email domain (e.g. "acme.com"). Self-registration matches an
  // employee's email domain to auto-join (or create) the right company.
  emailDomain String? @unique @map("email_domain")

  // Company Admin operator account (spec §2: Company Admin console).
  adminUserId String? @unique
  adminUser   User?   @relation("CompanyAdmin", fields: [adminUserId], references: [id])

  // Credit policy governing this company's employees (S1–S3).
  creditPolicyId String?       @unique
  creditPolicy   CreditPolicy? @relation(fields: [creditPolicyId], references: [id])

  employees        Employee[]
  addresses        Address[]
  orders           Order[]
  smartEppRequests SmartEppRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([leasingCompanyId])
  @@map("companies")
}

model Employee {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id])
  employeeCode  String
  department    String?
  monthlySalary Decimal         @db.Decimal(12, 2) // drives credit limit (S1–S3)
  program       EmployeeProgram @default(EPP)

  // HR-set credit limit (typically the employee's annual salary). Kept as a
  // simple stored ceiling for EPP; the Smart-EPP CreditAccount/ledger is separate.
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)

  creditAccount    CreditAccount?
  wallet           Wallet?
  cart             Cart?
  smartEppRequests SmartEppRequest[]
  orders           Order[]
  addresses        Address[]
  wishlistItems    WishlistItem[]
  reviews          ProductReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@map("employees")
}

model LeasingCompany {
  id           String    @id @default(cuid())
  name         String
  gstin        String?   @unique
  contactEmail String?
  contactPhone String?
  status       OrgStatus @default(ACTIVE)

  // Operator account for this partner org.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Lease parameters the leasing company sets in its portal. They feed the
  // Smart-EPP calculator (services/sepp-calc.ts) for every attached company.
  ptpm                    Decimal        @default(89.5) @db.Decimal(8, 4) // rental per ₹1000 of asset per month (incl. GST)
  defaultTenureMonths     Int            @default(12) @map("default_tenure_months")
  repurchasePct           Decimal        @default(2) @map("repurchase_pct") @db.Decimal(5, 2) // end-of-lease buyback, % of asset cost
  pvDiscountLeasePct      Decimal        @default(0) @map("pv_discount_lease_pct") @db.Decimal(5, 2) // PV discount on total lease payments
  pvDiscountRepurchasePct Decimal        @default(0) @map("pv_discount_repurchase_pct") @db.Decimal(5, 2) // PV discount on the repurchase price
  advanceFeeType          AdvanceFeeType @default(FIXED) @map("advance_fee_type")
  advanceFeeValue         Decimal        @default(0) @map("advance_fee_value") @db.Decimal(12, 2) // ₹ (FIXED) or % of asset (PERCENT)

  companies  Company[]
  leaseTerms LeaseTerms[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leasing_companies")
}

model Reseller {
  id           String    @id @default(cuid())
  name         String
  gstin        String?   @unique
  pan          String?
  contactEmail String?
  contactPhone String?
  status       OrgStatus @default(ACTIVE)

  // Platform commission on this reseller's sales (percentage, 0–100).
  commissionPct Decimal? @default(0) @map("commission_pct") @db.Decimal(5, 2)

  // Registered business address (single address; flat columns mirror `gstin`).
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  orders    Order[]
  products  Product[] // DEPRECATED single-seller link; use `offers`
  offers    ProductOffer[]
  coupons   Coupon[]
  freeGifts FreeGift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resellers")
}

model FulfillmentPartner {
  id           String    @id @default(cuid())
  name         String
  gstin        String?   @unique
  contactEmail String?
  contactPhone String?
  status       OrgStatus @default(ACTIVE)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fulfillment_partners")
}
