// ─────────────────────────────────────────────────────────────────────────────
// Orders (spec §3 — P2). Address model resolves S7 (office/home/company-defined).
// Exhibition QR discount reduces subtotal before surcharge/GST.
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id    String      @id @default(cuid())
  type  AddressType
  label String?

  // Owner is an employee or a company (COMPANY_DEFINED set). Exactly one is set.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])

  contactName  String
  contactPhone String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean @default(false)
  isBilling    Boolean @default(false)

  orders        Order[] @relation("OrderShippingAddress")
  billingOrders Order[] @relation("OrderBillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId])
  @@map("addresses")
}

model Order {
  id      String    @id @default(cuid())
  orderNo String    @unique
  type    OrderType

  // Origin: INTERNAL (employee checkout) or PARTNER (posted via /partner-api/v1).
  source      OrderSource @default(INTERNAL)
  partnerId   String?     @map("partner_id")
  partner     Partner?    @relation(fields: [partnerId], references: [id])
  // Partner's own order id (dedup + status lookups). Unique per partner.
  externalRef String?     @map("external_ref")

  // Partner-order metadata (GenieMart dealer + delivery instructions). Null for
  // internal orders. Echoed back on status/cancel pushes.
  dealerCode           String? @map("dealer_code")
  dealerName           String? @map("dealer_name")
  dealerMobile         String? @map("dealer_mobile")
  deliveryInstructions String? @map("delivery_instructions")
  cancelReason         String? @map("cancel_reason")

  // Buyer. Null for partner orders (no internal employee/company).
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])

  // Smart EPP orders reference the approved request (null for EPP).
  smartEppRequestId String?          @unique
  smartEppRequest   SmartEppRequest? @relation(fields: [smartEppRequestId], references: [id])

  // Reseller attribution (spec §2: reseller own-order dashboard).
  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id])

  // Marketplace: a mixed-seller checkout splits into one order per reseller,
  // all sharing this checkout group id (null for pre-marketplace orders).
  checkoutGroup String? @map("checkout_group")

  addressId String
  address   Address @relation("OrderShippingAddress", fields: [addressId], references: [id])

  // Billing address; null = same as the shipping address.
  billingAddressId String?
  billingAddress   Address? @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])

  // Applied coupon (null if none). couponCode is a snapshot so it survives coupon edits.
  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id])
  couponCode     String?
  couponDiscount Decimal @default(0) @db.Decimal(12, 2)

  // Amounts. Exhibition discount (buyer's QR campaign) reduces subtotal first.
  subtotal             Decimal             @db.Decimal(12, 2)
  exhibitionDiscount   Decimal             @default(0) @db.Decimal(12, 2)
  exhibitionCampaignId String?
  exhibitionCampaign   ExhibitionCampaign? @relation(fields: [exhibitionCampaignId], references: [id])
  surcharge            Decimal             @default(0) @db.Decimal(12, 2)
  gst                  Decimal             @default(0) @db.Decimal(12, 2)
  // Wallet money spent on this order (reduces payable); cashback earned on it
  // (credited to the wallet when the order is delivered).
  walletUsed           Decimal             @default(0) @map("wallet_used") @db.Decimal(12, 2)
  cashbackEarned       Decimal             @default(0) @map("cashback_earned") @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)

  status OrderStatus @default(PLACED)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipment      Shipment?
  documents     OrderDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, externalRef])
  @@index([employeeId])
  @@index([companyId])
  @@index([resellerId])
  @@index([partnerId])
  @@index([checkoutGroup])
  @@index([couponId])
  @@index([status])
  @@index([type])
  @@index([exhibitionCampaignId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  // Gift-card (Hubble voucher) issuance, when this line is a voucher. Lives in its
  // own table (different lifecycle than a physical line); its presence marks the
  // line as a voucher. See prisma/schema/vouchers.prisma.
  voucherFulfilment VoucherFulfilment?

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id])
  note        String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}
