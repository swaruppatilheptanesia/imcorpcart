// ─────────────────────────────────────────────────────────────────────────────
// Credit engine (spec §2 mgmt side / §3 employee display) — resolves S1–S3.
// Per-employee limit derived from monthly salary; a ledger is the source of truth
// for reserve (submission) / release (rejection|cancellation) / consume (fulfillment).
// ─────────────────────────────────────────────────────────────────────────────

// Per-company policy. Revolving vs one-time is a flag (S1). Limit is derived from
// the employee's monthly salary via salaryMultiplier.
model CreditPolicy {
  id               String       @id @default(cuid())
  name             String
  model            CreditModel  @default(REVOLVING)
  period           CreditPeriod @default(MONTHLY)
  salaryMultiplier Decimal      @default(1.00) @db.Decimal(6, 2) // limit = monthlySalary * multiplier
  maxLimit         Decimal?     @db.Decimal(12, 2) // optional hard cap

  // Reserve/release rule config (S2/S3) — booleans keep behaviour tunable.
  reserveOnSubmission   Boolean @default(true)
  releaseOnRejection    Boolean @default(true)
  releaseOnCancellation Boolean @default(true)

  company Company?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_policies")
}

model CreditAccount {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Cached balances — derived from the ledger, kept for fast reads.
  creditLimit     Decimal @db.Decimal(12, 2)
  availableCredit Decimal @db.Decimal(12, 2)
  reservedCredit  Decimal @default(0) @db.Decimal(12, 2)

  periodResetAt DateTime? // next revolving roll-over (null for one-time)

  ledgerEntries CreditLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_accounts")
}

// Append-only ledger — the authoritative record of every credit movement.
model CreditLedgerEntry {
  id              String           @id @default(cuid())
  creditAccountId String
  creditAccount   CreditAccount    @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  type            CreditLedgerType
  amount          Decimal          @db.Decimal(12, 2)
  balanceAfter    Decimal          @db.Decimal(12, 2)

  // Polymorphic reference to what triggered the movement.
  referenceType String? // "SMART_EPP_REQUEST" | "ORDER" | ...
  referenceId   String?
  note          String?

  createdAt DateTime @default(now())

  @@index([creditAccountId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("credit_ledger_entries")
}
