// ─────────────────────────────────────────────────────────────────────────────
// Fulfillment & courier abstraction (spec §1 layer + §2 uploads / §3 tracking).
// Invoice/e-way documents are hybrid (GENERATED | UPLOADED) per S5/S6.
// ─────────────────────────────────────────────────────────────────────────────

model Courier {
  id       String          @id @default(cuid())
  code     CourierCode     @unique
  name     String
  priority CourierPriority @default(MEDIUM)
  active   Boolean         @default(true)

  config    CourierConfig?
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("couriers")
}

model CourierConfig {
  id         String  @id @default(cuid())
  courierId  String  @unique
  courier    Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)
  apiKeyRef  String? // reference into secrets store
  apiBaseUrl String?
  active     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courier_configs")
}

model Shipment {
  id                   String              @id @default(cuid())
  orderId              String              @unique
  order                Order               @relation(fields: [orderId], references: [id])
  // Optional: a reseller can self-fulfil and drive transit without a partner assigned.
  fulfillmentPartnerId String?
  fulfillmentPartner   FulfillmentPartner? @relation(fields: [fulfillmentPartnerId], references: [id])
  courierId            String?
  courier              Courier?            @relation(fields: [courierId], references: [id])

  awbNumber      String? // airway bill (spec §2: fulfillment console)
  status         ShipmentStatus @default(PENDING)
  trackingActive Boolean        @default(true) // auto-stop on delivery (spec §3)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  podUrl         String? // proof of delivery upload
  // How the parcel actually travelled, captured at dispatch and defaulted from
  // the line's Product.deliveryMode. The product field is only a preference;
  // this is the record of what was used.
  deliveryMode   DeliveryMode? @map("delivery_mode")

  // Courier-aggregator (H.K. Data Services) state. `labelUrl` is the shipping
  // label PDF returned at AWB generation — printed before dispatch, NOT a proof
  // of delivery. `nextPollAt` is the tracking poller's claim predicate (same
  // shape as WebhookDelivery.nextAttemptAt); null = never polled / due now.
  // `trackingError` holds the last failure reason so staff can see why automatic
  // tracking is not advancing and fall back to a manual transit update.
  labelUrl      String?   @map("label_url")
  lastTrackedAt DateTime? @map("last_tracked_at")
  nextPollAt    DateTime? @map("next_poll_at")
  trackingError String?   @map("tracking_error")

  trackingEvents ShipmentTrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentPartnerId])
  @@index([courierId])
  @@index([status])
  // A transit update often touches only this row, so partner polling filters on
  // it as well as on the order's own updatedAt.
  @@index([updatedAt])
  @@map("shipments")
}

model ShipmentTrackingEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String?
  occurredAt  DateTime
  raw         Json? // raw courier-API payload

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([occurredAt])
  @@map("shipment_tracking_events")
}

// Invoice / e-way / POD documents. `source` marks generated vs uploaded (hybrid).
model OrderDocument {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  docType      DocumentType
  source       DocumentSource
  number       String?
  fileUrl      String?
  generatedAt  DateTime?
  uploadedById String?
  uploadedBy   User?          @relation("DocUploader", fields: [uploadedById], references: [id])
  // Why this proof is disputed or incomplete — operator-entered at upload.
  // A real column rather than metadata JSON: it is a reported field, and the
  // old metadata.note path was never written by any UI.
  issueNote    String?        @map("issue_note")
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([docType])
  @@map("order_documents")
}
