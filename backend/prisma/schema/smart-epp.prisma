// ─────────────────────────────────────────────────────────────────────────────
// Smart EPP request & approval (spec §2 consoles / §3 employee flow) — S4.
// Whole-request approval through a sequential, UNANIMOUS multi-stage flow:
// every stage must approve; any single rejection rejects the entire request.
// ─────────────────────────────────────────────────────────────────────────────

model SmartEppRequest {
  id          String         @id @default(cuid())
  requestNo   String         @unique
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  status      SmartEppStatus @default(DRAFT)
  totalAmount Decimal        @db.Decimal(12, 2) // asset cost total (incl. GST)
  submittedAt DateTime?
  decidedAt   DateTime?

  // Smart-EPP orders ship only to a company-defined office branch (Address.companyId set).
  addressId String
  address   Address @relation("SmartEppRequestAddress", fields: [addressId], references: [id])

  // Snapshot of the lease calculation (services/sepp-calc.ts SeppQuote) at
  // submission, so approvals and the resulting orders never recompute against
  // parameters that changed later.
  quote Json?

  // Advance levied by the leasing company, paid via Razorpay at submission.
  // Refunded (advanceRefundedAt) when HR / Leasing rejects or the employee cancels.
  advanceAmount         Decimal   @default(0) @map("advance_amount") @db.Decimal(12, 2)
  advanceGatewayOrderId String?   @map("advance_gateway_order_id")
  advanceTxnId          String?   @unique @map("advance_txn_id")
  advancePaidAt         DateTime? @map("advance_paid_at")
  advanceRefundedAt     DateTime? @map("advance_refunded_at")

  // Set when leasing approval creates the orders (one per fulfilling seller).
  checkoutGroup String? @map("checkout_group")

  items      SmartEppRequestItem[]
  approvals  ApprovalStep[]
  leaseTerms LeaseTerms?
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
  @@index([addressId])
  @@map("smart_epp_requests")
}

// Line items — approval is whole-request (no line-level approval, per S4).
model SmartEppRequestItem {
  id        String          @id @default(cuid())
  requestId String
  request   SmartEppRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  lineTotal Decimal         @db.Decimal(12, 2)

  @@index([requestId])
  @@map("smart_epp_request_items")
}

// One row per approval stage (HR stage-1, Leasing stage-2). Sequenced by `sequence`.
// Unanimous rule enforced in app logic: any REJECTED -> request REJECTED (+ credit
// RELEASE); all APPROVED -> request advances.
model ApprovalStep {
  id             String          @id @default(cuid())
  requestId      String
  request        SmartEppRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage          ApprovalStage
  sequence       Int
  status         ApprovalStatus  @default(PENDING)
  approverUserId String?
  approver       User?           @relation(fields: [approverUserId], references: [id])
  comments       String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([requestId, stage])
  @@index([requestId])
  @@index([approverUserId])
  @@map("approval_steps")
}

// EMI / lease terms entered by the leasing company at stage 2.
model LeaseTerms {
  id               String          @id @default(cuid())
  requestId        String          @unique
  request          SmartEppRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leasingCompanyId String
  leasingCompany   LeasingCompany  @relation(fields: [leasingCompanyId], references: [id])
  tenureMonths     Int
  interestRate     Decimal         @db.Decimal(5, 2)
  downPayment      Decimal         @default(0) @db.Decimal(12, 2)
  financedAmount   Decimal         @db.Decimal(12, 2)
  emiAmount        Decimal         @db.Decimal(12, 2)

  installments LeaseScheduleInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leasingCompanyId])
  @@map("lease_terms")
}

// Schedule generated at leasing approval. Repayments themselves happen via
// payroll outside the platform; HR marks an installment paid (paidAt), which
// replenishes the employee's Smart-EPP purchase limit by that EMI.
model LeaseScheduleInstallment {
  id            String     @id @default(cuid())
  leaseTermsId  String
  leaseTerms    LeaseTerms @relation(fields: [leaseTermsId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  amount        Decimal    @db.Decimal(12, 2)
  paidAt        DateTime?  @map("paid_at")
  paidById      String?    @map("paid_by_id")

  @@unique([leaseTermsId, installmentNo])
  @@index([leaseTermsId])
  @@map("lease_schedule_installments")
}
