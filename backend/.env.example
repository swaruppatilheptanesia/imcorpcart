# PostgreSQL connection for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://swaruppatil@localhost:5432/imcorpcart?schema=public"

# ─── API server ──────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN="http://localhost:5173"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string in any real deployment.
JWT_SECRET="dev-only-change-me-to-a-long-random-secret"
JWT_EXPIRES="12h"
BCRYPT_ROUNDS=10

# One-time email sign-in code lifetime, in minutes.
OTP_TTL_MIN=10

# Legacy 2FA toggle. Login is now passwordless (email → emailed OTP), so this no
# longer gates sign-in; kept for backward compatibility.
OTP_ENABLED=true

# Comma-separated emails that skip the OTP step and sign in directly — for demo
# accounts on domains that can't receive real email (e.g. the seeded Super Admin).
# Everyone else uses email-OTP. Leave blank in production.
OTP_BYPASS_EMAILS="admin@imcorpcart.local"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sends passwordless login codes. From the Resend dashboard (API Keys). Leave
# blank to disable email — the code is then only logged to the server console and
# returned as devOtp (non-production), so local testing still works.
RESEND_API_KEY=""
# Sender identity; the domain must be verified in Resend (e.g. imcorpcart.com).
RESEND_FROM="imcorpcart <no-reply@imcorpcart.com>"

# Master checkout switch. false = browse/register only (order endpoints 403 and
# the storefront hides pay/checkout); set true with live payment keys to open
# ordering. Leave true (default) for normal operation.
CHECKOUT_ENABLED=true

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# From the Razorpay dashboard (Settings → API keys). Use rzp_test_* keys for
# test mode. Leave blank to disable online payment (checkout will error).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: a saved Checkout Configuration id (Dashboard → Payment methods
# configuration) to control which methods appear, e.g. "config_XXXX". Blank = all
# enabled methods.
RAZORPAY_CHECKOUT_CONFIG_ID=""

# Partner integration API (/partner-api/v1). PARTNER_API_ENABLED=false returns 403
# on every partner endpoint. PARTNER_SECRET_ENC_KEY is the master key used to
# AES-encrypt each partner's signing secret at rest — set a long random string in
# production (e.g. `openssl rand -base64 48`); required to create/rotate partners.
PARTNER_API_ENABLED="true"
PARTNER_SECRET_ENC_KEY=""
