# PostgreSQL connection for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://swaruppatil@localhost:5432/imcorpcart?schema=public"

# ─── API server ──────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN="http://localhost:5173"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string in any real deployment.
JWT_SECRET="dev-only-change-me-to-a-long-random-secret"
JWT_EXPIRES="12h"
BCRYPT_ROUNDS=10

# One-time email sign-in code lifetime, in minutes.
OTP_TTL_MIN=10

# Legacy 2FA toggle. Login is now passwordless (email → emailed OTP), so this no
# longer gates sign-in; kept for backward compatibility.
OTP_ENABLED=true

# Note: demo accounts that skip email-OTP (Super Admin + storefront demo shopper)
# are hardcoded in code (config/constants.ts DEMO_LOGIN_EMAILS) and only active in
# non-production — there is no OTP bypass env var. Everyone else uses email-OTP.

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sends passwordless login codes. From the Resend dashboard (API Keys). Leave
# blank to disable email — the code is then only logged to the server console and
# returned as devOtp (non-production), so local testing still works.
RESEND_API_KEY=""
# Sender identity; the domain must be verified in Resend (e.g. imcorpcart.com).
RESEND_FROM="imcorpcart <no-reply@imcorpcart.com>"

# Master checkout switch. false = browse/register only (order endpoints 403 and
# the storefront hides pay/checkout); set true with live payment keys to open
# ordering. Leave true (default) for normal operation.
CHECKOUT_ENABLED=true

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# From the Razorpay dashboard (Settings → API keys). Use rzp_test_* keys for
# test mode. Leave blank to disable online payment (checkout will error).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: a saved Checkout Configuration id (Dashboard → Payment methods
# configuration), e.g. "config_XXXX", deciding which methods an order may use.
# Blank = all methods enabled on the account.
#
# The storefront already locks the modal to the single method the shopper picked at
# checkout, so ONE configuration allowing UPI + card + net banking is enough — it
# only has to be wide enough to permit whatever they chose. A configuration that
# omits a method the picker offers makes that choice open an empty modal.
RAZORPAY_CHECKOUT_CONFIG_ID=""
# Optional: enforce the choice dashboard-side as well, with one configuration per
# method. When set, the shopper's method uses its own id instead of the shared one
# above; unset methods fall back to it. Credit and debit share the card id — they
# are one Razorpay method and only the per-order lock can tell them apart.
RAZORPAY_CHECKOUT_CONFIG_ID_UPI=""
RAZORPAY_CHECKOUT_CONFIG_ID_CARD=""
RAZORPAY_CHECKOUT_CONFIG_ID_NETBANKING=""

# Partner integration API (/partner-api/v1). PARTNER_API_ENABLED=false returns 403
# on every partner endpoint. PARTNER_SECRET_ENC_KEY is the master key used to
# AES-encrypt each partner's signing secret at rest — set a long random string in
# production (e.g. `openssl rand -base64 48`); required to create/rotate partners.
PARTNER_API_ENABLED="true"
PARTNER_SECRET_ENC_KEY=""

# Inbound vendor import (Vendor Sources). VENDOR_IMPORT_MAX_PAGES caps how many
# pages a sync pulls from a vendor API. Blank (recommended, all environments) = pull
# the whole catalog, bounded by the vendor's own last page. Set a number ONLY for a
# deliberately bounded trial — a capped run is a partial view of the feed, so it also
# disables the prune step that deactivates products which vanished from the vendor.
# VENDOR_IMPORT_MAX_PAGES=

# Hubble (myhubble.money) gift-card voucher catalog + voucher fulfilment. Get the
# client id/secret from the Hubble Integrations console. Put the SECRET in .env ONLY
# — never commit it. Blank base URL = Hubble PRODUCTION (https://api.myhubble.money);
# set the staging host below only for sandbox testing. Staging has a different, partly
# fictitious brand list whose ids production rejects at order time — make sure the
# credentials and the base URL are from the same environment.
HUBBLE_CLIENT_ID=""
HUBBLE_CLIENT_SECRET=""
# HUBBLE_BASE_URL="https://api.dev.myhubble.money"
